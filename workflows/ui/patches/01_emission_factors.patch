+def emission_factor_per_output_pj(arch: str) -> float:
+    """Return CO2 emissions per PJ of plant output activity.
+
+    ``ARCH[...]["co2"]`` is a fuel-input factor: the placeholder values 0.051
+    and 0.090 are t/GJ, which is numerically identical to Mt/PJ.  OSeMOSYS
+    applies ``EmissionActivityRatio`` to output activity, while each plant
+    consumes ``InputActivityRatio`` PJ of fuel per PJ of output, so the
+    parameter must be scaled by that input ratio.
+
+    Args:
+        arch: Power-plant archetype code, e.g. ``NGS`` or ``COA``.
+
+    Returns:
+        Mt CO2 per PJ of output activity.
+
+    Raises:
+        KeyError: If the archetype has no documented input activity ratio.
+
+    """
+    if arch not in ms.PowerPlants:
+        raise KeyError(f"{arch}: no documented power-plant input activity ratio")
+    input_ratio = float(ms.PowerPlants[arch][1])
+    return round(float(ARCH[arch]["co2"]) * input_ratio, 6)
+
