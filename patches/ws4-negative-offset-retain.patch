                         )
                 tracks[index] = treatment[0]
-                offsets[index] = treatment[1]
+                if treatment[1] >= 0:
+                    offsets[index] = treatment[1]
                 changed = True
                 disturbed.add(block_id)
         if changed:
@@ -660,7 +661,8 @@
